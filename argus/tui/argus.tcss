Screen {
    layout: vertical;
}

#status {
    dock: top;
    height: 1;
    background: $panel;
    color: $foreground;
}

#body {
    height: 1fr;
}

#transcript {
    width: 1fr;
    padding: 0 1;
    scrollbar-size-vertical: 1;
}

#sidebar {
    width: 34;
    padding: 0 1;
    border-left: vkey $panel;
    color: $foreground;
}

.side-title {
    color: $accent;
    text-style: bold;
    margin-top: 1;
}

.user {
    color: $accent;
    text-style: bold;
    margin-top: 1;
}

.reasoning {
    color: $text-muted;
    text-style: italic;
}

.tool {
    color: $secondary;
}

.tool-fail {
    color: $error;
}

.note {
    color: $text-muted;
}

.failure {
    color: $warning;
}

.final {
    margin: 0 0 1 0;
}

#prompt {
    margin: 0 1;
    border: tall $primary;
}

ApprovalScreen, PickerScreen, TextScreen {
    align: center middle;
    background: $background 60%;
}

#approval {
    width: 90;
    height: auto;
    border: thick $warning;
    background: $surface;
    padding: 1 2;
}

#approval-summary {
    text-style: bold;
    margin: 1 0;
}

#approval-buttons {
    height: auto;
    margin-top: 1;
}

#approval-buttons Button {
    margin-right: 2;
}

#picker, #text-screen {
    width: 100;
    height: 80%;
    border: thick $primary;
    background: $surface;
    padding: 0 1;
}

#picker-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

.dim {
    color: $text-muted;
}
